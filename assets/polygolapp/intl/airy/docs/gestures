<script>
(function() {
    function translateDoc() {
        const langCode = (localStorage.getItem('selectedLanguage') || 'EN').toUpperCase();
        const langMap = { 'EN': window.LANG_EN, 'JP': window.LANG_JP, 'JA': window.LANG_JP, 'KO': window.LANG_KO, 'ZH': window.LANG_ZH };
        const L = (window.currentLanguage) || (langMap[langCode]) || window.LANG_EN;
        if (!L) return;
        document.querySelectorAll('[data-lang-key]').forEach(el => {
            const key = el.getAttribute('data-lang-key');
            if (L[key]) el.textContent = L[key];
        });
    }
    if (typeof window.LANG_EN === 'undefined') {
        const s = document.createElement('script');
        s.src = '/assets/polygolapp/intl/airy/lang.js';
        s.onload = translateDoc;
        document.head.appendChild(s);
    } else {
        translateDoc();
    }
})();
</script>