<div style="text-align: center; max-width: 520px; margin: 0 auto; font-family: 'Open Runde', 'Inter', sans-serif;">
    <div style="margin-top: 24px; margin-bottom: 20px;">
        <img src="/assets/appicon/system.png" alt="Ready" style="width: 72px; height: 72px; border-radius: 50%; box-shadow: var(--sun-shadow); --fx-filter: var(--blur1) glass(0.6, 8, 0);">
    </div>
    <h1 style="margin: 0 0 12px 0; font-size: 2.2rem; font-weight: 700; color: var(--text-color);" data-lang-key="FINISH_TITLE">Ready?</h1>
    <p style="font-size: 1.15rem; line-height: 1.6; opacity: 0.85; color: var(--text-color); margin-bottom: 32px;" data-lang-key="FINISH_DESC">
        You've learned the basics of Polygol navigation and customization.
    </p>

    <button onclick="if(typeof completeAiryOnboarding==='function')completeAiryOnboarding();else if(window.parent&&window.parent.postMessage)window.parent.postMessage({type:'onboarding-complete'},'*');" style="
        padding: 16px 36px;
        border-radius: 35px;
        background: var(--text-color);
        color: var(--background-color);
        border: none;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        font-family: inherit;
        box-shadow: var(--sun-shadow), 0 4px 20px rgba(0,0,0,0.25);
        transition: transform 0.2s cubic-bezier(0.2, 1.3, 0.64, 1);
        display: inline-flex;
        align-items: center;
        gap: 10px;">
        <span class="material-symbols-rounded" style="font-size: 22px;">rocket_launch</span>
        <span data-lang-key="FINISH_START">Get Started</span>
    </button>
    <br><br>
    <p style="font-size: 0.85rem; opacity: 0.6; color: var(--secondary-text-color);" data-lang-key="FINISH_NOTE">
        Enjoy your personalized desktop experience.
    </p>
</div>
<script>
(function() {
    function translateDoc() {
        const langCode = (localStorage.getItem('selectedLanguage') || 'EN').toUpperCase();
        const langMap = { 'EN': window.LANG_EN, 'JP': window.LANG_JP, 'JA': window.LANG_JP, 'KO': window.LANG_KO, 'ZH': window.LANG_ZH };
        const L = (window.currentLanguage) || (langMap[langCode]) || window.LANG_EN;
        if (!L) return;
        document.querySelectorAll('[data-lang-key]').forEach(el => {
            const key = el.getAttribute('data-lang-key');
            if (L[key]) el.textContent = L[key];
        });
    }
    if (typeof window.LANG_EN === 'undefined') {
        const s = document.createElement('script');
        s.src = '/assets/polygolapp/intl/airy/lang.js';
        s.onload = translateDoc;
        document.head.appendChild(s);
    } else {
        translateDoc();
    }
})();
</script>